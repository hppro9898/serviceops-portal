# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-ssr/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment
.env
.env.local
.env.*.local

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db

# Archives / backups (the original export zip)
*.zip

# Local credentials — never commit
credentials.txt
*.credentials

# Screenshots dropped into the project root while working. Project images live
# under src/assets and src/imports; anything landing here is a working file and
# must not be swept into a public repo by `git add -A`.
/screencapture-*.png
/Screenshot*.png
/screenshot*.png
/*.jpg
/*.jpeg

# Pushing this needs a token with the `workflow` scope, which the current one lacks.
# Deploy runs from the gh-pages branch instead. To switch to CI builds:
#   gh auth refresh -s workflow   then   git rm --cached -r --ignore-unmatch . && git add -A
.github/workflows/

# Local snapshots and assistant config — not part of the app
.backup-*/
.claude/
